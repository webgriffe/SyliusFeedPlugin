{% set feed = hookable_metadata.context.resource %}

<div class="mb-2">
    <div class="card">
        <div class="card-body">
            {% if workflow_has_marked_place(feed, constant('Setono\\SyliusFeedPlugin\\Workflow\\FeedGraph::STATE_READY')) or workflow_has_marked_place(feed, constant('Setono\\SyliusFeedPlugin\\Workflow\\FeedGraph::STATE_PROCESSING')) %}
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>{{ 'sylius.ui.channel'|trans }}</th>
                            <th>{{ 'sylius.ui.locale'|trans }}</th>
                            <th>{{ 'setono_sylius_feed.ui.link'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for channel in feed.channels %}
                            {% for locale in channel.locales %}
                                {% set feedUrl = setono_sylius_feed_generate_feed_url(feed, channel, locale) %}
                                {% set feedbackId = 'feed-link-copied-' ~ loop.parent.loop.index ~ '-' ~ loop.index %}
                                <tr>
                                    <td>{{ channel.name }}</td>
                                    <td>{{ locale.name }}</td>
                                    <td>
                                        <div class="input-group">
                                            <input type="text"
                                                   class="form-control form-control-sm font-monospace"
                                                   value="{{ feedUrl }}"
                                                   readonly
                                                   aria-label="{{ 'setono_sylius_feed.ui.link'|trans }}">
                                            <button class="btn btn-outline-secondary"
                                                    type="button"
                                                    data-copy-url="{{ feedUrl }}"
                                                    data-copy-feedback="{{ feedbackId }}"
                                                    title="{{ 'setono_sylius_feed.ui.click_to_copy'|trans }}">
                                                {{ ux_icon('tabler:copy', { class: 'icon' }) }}
                                            </button>
                                        </div>
                                        <span id="{{ feedbackId }}" class="d-none text-success small mt-1 d-flex align-items-center gap-1">
                                            {{ ux_icon('tabler:check', { class: 'icon icon-sm' }) }}
                                            {{ 'setono_sylius_feed.ui.link_copied'|trans }}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-title">{{ 'setono_sylius_feed.ui.unprocessed_feed_header'|trans }}</h4>
                    <p class="text-secondary mt-1 mb-0">{{ 'setono_sylius_feed.ui.unprocessed_feed_body'|trans }}</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
