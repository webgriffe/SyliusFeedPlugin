{% set feed = hookable_metadata.context.resource %}

<div class="mb-2">
    <div class="card">
        <div class="card-body">
            {% if workflow_has_marked_place(feed, constant('Setono\\SyliusFeedPlugin\\Workflow\\FeedGraph::STATE_READY')) or workflow_has_marked_place(feed, constant('Setono\\SyliusFeedPlugin\\Workflow\\FeedGraph::STATE_PROCESSING')) %}
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>{{ 'sylius.ui.channel'|trans }}</th>
                            <th>{{ 'sylius.ui.locale'|trans }}</th>
                            <th>{{ 'setono_sylius_feed.ui.link'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for channel in feed.channels %}
                            {% for locale in channel.locales %}
                                <tr>
                                    <td>{{ channel.name }}</td>
                                    <td>{{ locale.name }}</td>
                                    <td>
                                        <div class="input-group"
                                             data-controller="setono--sylius-feed-plugin--copy"
                                             data-action="click->setono--sylius-feed-plugin--copy#copy">
                                            <input type="text"
                                                   class="form-control"
                                                   value="{{ setono_sylius_feed_generate_feed_url(feed, channel, locale) }}"
                                                   readonly
                                                   data-setono--sylius-feed-plugin--copy-target="input">
                                            <button class="btn btn-outline-secondary" type="button"
                                                    title="{{ 'setono_sylius_feed.ui.click_to_copy'|trans }}">
                                                {{ ux_icon('tabler:copy') }}
                                            </button>
                                            <span class="ms-2 align-self-center badge bg-success d-none"
                                                  data-setono--sylius-feed-plugin--copy-target="feedback">
                                                {{ ux_icon('tabler:check') }} {{ 'setono_sylius_feed.ui.link_copied'|trans }}
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="alert alert-info">
                    <h4 class="alert-title">{{ 'setono_sylius_feed.ui.unprocessed_feed_header'|trans }}</h4>
                    <p class="text-secondary mt-1 mb-0">{{ 'setono_sylius_feed.ui.unprocessed_feed_body'|trans }}</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
